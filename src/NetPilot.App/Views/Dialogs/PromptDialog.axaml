<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetPilot.App.Views.Dialogs.PromptDialog"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/netpilot-icon.ico"
        Background="{DynamicResource SurfaceBrush}">
  <Border Padding="24">
    <StackPanel Spacing="14">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="LabelText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBox x:Name="InputBox" MinHeight="34" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
        <Button Content="取消" Classes="ghost" MinWidth="76" IsCancel="True" Click="OnCancel" />
        <Button Content="确定" Classes="primary" MinWidth="76" IsDefault="True" Click="OnOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
